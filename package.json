{
  "name": "aplikasi-geometri-transformasi",
  "private": true,
  "version": "1.0.0",
  "description": "Visualisasi interaktif transformasi geometri",
  "scripts": {
    "check": "node --check script.js && node --check transformations.js && node --check utils.js && node --check sw.js",
    "test": "node --test tests/*.test.js",
    "build:icons": "node scripts/build-icons.js",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./assets/app.css --minify",
    "build": "npm run build:icons && npm run build:css && npm run build:sw && npm run check && npm test",
    "build:sw": "node scripts/build-sw.js",
    "build:pwa-icons": "node scripts/build-pwa-icons.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2"
  }
}
